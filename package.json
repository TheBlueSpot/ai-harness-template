{
  "name": "ai-harness-template",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun harness/cli/src/index.ts",
    "dev": "bun --hot harness/cli/src/index.ts",
    "dev:cli": "bun --hot harness/cli/src/index.ts --server-only",
    "bootstrap": "bun run scripts/bootstrap.ts",
    "build:release:win64": "bun run scripts/package-launcher.ts --target bun-windows-x64",
    "build:ui": "bun run scripts/build-ui.ts",
    "doctor": "bun harness/cli/src/index.ts --doctor",
    "lint:tailwind": "eslint \"harness/ui/src/**/*.{ts,tsx}\"",
    "package:launcher": "bun run scripts/package-launcher.ts",
    "screenshot": "bun run scripts/screenshot.ts",
    "test": "bun run scripts/run-tests.ts",
    "test:profile": "bun run scripts/profile-tests.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@mariozechner/pi-coding-agent": "^0.66.1",
    "@openai/codex": "^0.122.0",
    "@openai/codex-sdk": "^0.122.0",
    "@tanstack/solid-hotkeys": "^0.9.1",
    "@vscode/ripgrep": "^1.17.1",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.8.0",
    "pdfjs-dist": "^5.6.205",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "solid-js": "^1.9.12",
    "solid-markdown": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "uploadthing": "^7.7.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@dschz/bun-plugin-solid": "^1.0.4",
    "@happy-dom/global-registrator": "^20.0.10",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/node": "^4.2.2",
    "@types/node": "^24.3.0",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/parser": "^8.58.2",
    "babel-preset-solid": "^1.9.12",
    "bun-types": "^1.2.21",
    "eslint": "^10.2.0",
    "eslint-plugin-tailwind-canonical-classes": "^1.3.2",
    "playwright": "^1.59.1",
    "typescript": "^5.9.2"
  }
}
